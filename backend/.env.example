# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (website + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/printing-galaxy

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
# Set to true in production behind HTTPS
COOKIE_SECURE=false

# ── Storage (AWS S3 or any S3-compatible service; local SeaweedFS listens on :8333) ──
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_PRIVATE_BUCKET=printing-galaxy-private
S3_PUBLIC_BUCKET=printing-galaxy-public
# Public base URL for objects in the public bucket (product images, logos)
S3_PUBLIC_BASE_URL=http://localhost:8333/printing-galaxy-public
MAX_UPLOAD_MB=100

# ── Payments (leave empty to allow only pay-at-counter / COD) ──
# Key ID and secret must be one pair from the same mode (rzp_test_… with its test secret).
# The account must auto-capture payments (Razorpay default): a confirmed payment is booked as paid.
# Webhook (Dashboard → Webhooks): <API URL>/api/v1/payments/razorpay/webhook with payment.captured,
# order.paid, payment.failed, refund.processed, refund.failed; its secret goes in RAZORPAY_WEBHOOK_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Messages ─────────────────────────────────────────────
# email: customers sign in with a code sent by email; order updates and offers go by email (Gmail).
# sms:   the same by SMS through MSG91 (needs DLT registration, see below).
MESSAGING_CHANNEL=email
# Gmail account and an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Leave empty in development to print emails and codes in the API log instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Printing Galaxy
# Website address for links in emails (order pages, unsubscribe).
WEBSITE_URL=http://localhost:5173

# ── Staff phone notifications (Web Push) ──
# Generate once with: npx web-push generate-vapid-keys   (leave empty to keep notifications off)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@printinggalaxy.in
# Admin panel address, opened when a staff member taps a notification.
ADMIN_URL=http://localhost:5174

# ── SMS via MSG91 (only used with MESSAGING_CHANNEL=sms) ──
# Every SMS needs a DLT-approved template, added in MSG91 → SMS → Templates. In MSG91 write the
# variables as ##var1##, ##var2##, …; on DLT each is {#var#} (max 30 characters).
MSG91_AUTH_KEY=
# OTP template, e.g. "##OTP## is your Printing Galaxy login code. Do not share it with anyone."
MSG91_OTP_TEMPLATE_ID=
# "Printing Galaxy: Your order ##var1## ##var2##. ##var3##"
MSG91_TEMPLATE_ORDER_STATUS=
# "Printing Galaxy: Your order ##var1## is ready for pickup. Show code ##var2## at the counter."
MSG91_TEMPLATE_PICKUP_CODE=
# "Printing Galaxy: Your order ##var1## is out for delivery. Give code ##var2## to the delivery person only after you receive it."
MSG91_TEMPLATE_DELIVERY_CODE=
# "Printing Galaxy: Your institution account ##var1## ##var2##."
MSG91_TEMPLATE_ACCOUNT_UPDATE=
# Sent to the shop phone: "Printing Galaxy alert: ##var1## - ##var2##. Check the admin panel."
MSG91_TEMPLATE_STAFF_ALERT=
# Promotional SMS templates are added in Admin → Promotions, not here.

# ── Background jobs (optional) ───────────────────────────
# Redis for BullMQ, e.g. redis://localhost:6379. Empty = jobs run in the API process.
REDIS_URL=

# ── Seed ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=owner@printinggalaxy.in
SEED_ADMIN_PASSWORD=ChangeMe@123
