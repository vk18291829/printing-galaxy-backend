# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (website + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/printing-galaxy

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
# Set to true in production behind HTTPS
COOKIE_SECURE=false

# ── Storage (AWS S3 or any S3-compatible service; docker-compose runs SeaweedFS on :8333) ──
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
S3_PRIVATE_BUCKET=printing-galaxy-private
S3_PUBLIC_BUCKET=printing-galaxy-public
# Public base URL for objects in the public bucket (product images, logos)
S3_PUBLIC_BASE_URL=http://localhost:8333/printing-galaxy-public
MAX_UPLOAD_MB=100

# ── Payments (leave empty to allow only pay-at-counter / COD) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Notifications (leave empty to log messages to the console) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names (needed to message customers outside the 24-hour window).
# Bodies: order "Your order {{1}} {{2}}. {{3}}" · account "Printing Galaxy: {{1}} {{2}}" · staff "Printing Galaxy alert: {{1}}"
WHATSAPP_TEMPLATE_ORDER_STATUS=
WHATSAPP_TEMPLATE_ACCOUNT_UPDATE=
WHATSAPP_TEMPLATE_STAFF_ALERT=
# Webhook (delivery receipts → SMS fallback): GET/POST /api/v1/notifications/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=PRNTGL
MSG91_OTP_TEMPLATE_ID=
# DLT-approved MSG91 flow for status SMS; receives the same variables as var1, var2, var3
MSG91_STATUS_TEMPLATE_ID=

# ── Background jobs (optional) ───────────────────────────
# Redis for BullMQ (docker compose --profile queue up -d redis). Empty = jobs run in the API process.
REDIS_URL=

# ── Seed ─────────────────────────────────────────────────
SEED_ADMIN_EMAIL=owner@printinggalaxy.in
SEED_ADMIN_PASSWORD=ChangeMe@123
